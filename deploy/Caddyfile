# Public ingress: signed provider webhooks only. Administrative API stays on localhost.
{$CLIPRUSH_DOMAIN} {
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000"
    }

    @webhooks path /hooks/openshorts /hooks/kick /hooks/telegram
    handle @webhooks {
        reverse_proxy api:8080
    }

    handle {
        respond "Not found" 404
    }
}
